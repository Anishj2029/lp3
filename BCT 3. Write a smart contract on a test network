pragma solidity ^0.8.20;

contract BankAccount {
    // Mapping to track the balance of each account holder
    mapping(address => uint256) private balances;

    // Events for logging transactions on the blockchain
    event Deposit(address indexed accountHolder, uint256 amount);
    event Withdraw(address indexed accountHolder, uint256 amount);

    /**
     * @notice Allows a user to deposit Ether into their bank account.
     * The deposited amount (msg.value in Wei) is added to the caller's balance.
     */
    function deposit() public payable {
        require(msg.value > 0, "Deposit amount must be greater than zero");
        balances[msg.sender] += msg.value;
        emit Deposit(msg.sender, msg.value);
    }

    /**
     * @notice Allows a user to withdraw a specified amount of Ether from their account.
     * @param _amount The amount in Wei to withdraw.
     */
    function withdraw(uint256 _amount) public {
        require(_amount > 0, "Withdrawal amount must be greater than zero");
        require(balances[msg.sender] >= _amount, "Insufficient balance");
        
        // Deduct balance prior to transfer to prevent re-entrancy attacks
        balances[msg.sender] -= _amount;
        
        // Transfer Ether to the caller
        payable(msg.sender).transfer(_amount);
        emit Withdraw(msg.sender, _amount);
    }

    /**
     * @notice Returns the current balance of the caller.
     * @return Balance in Wei.
     */
    function showBalance() public view returns (uint256) {
        return balances[msg.sender];
    }
}
