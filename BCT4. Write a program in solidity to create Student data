pragma solidity ^0.8.20; 

contract StudentRegister { 
    // Contract deployer/owner
    address public owner; 

    // 1. Structure definition for Student
    struct Student { 
        uint256 studentId; 
        string name; 
        uint256[] marks; // 2. Dynamic Array for subject marks 
        uint256 percentage; 
        bool exist; 
    }

    // Mapping from Student ID to Student record
    mapping(uint256 => Student) private students; 

    // Events for logging
    event StudentRegistered(uint256 indexed studentId, string name, uint256 percentage); 
    event FallbackCalled(address sender, uint256 value, bytes data); 

    modifier onlyOwner() { 
        require(msg.sender == owner, "Unauthorized: Only the contract owner can perform this action."); 
        _; 
    }

    constructor() payable { 
        owner = msg.sender; 
    }

    /**
     * @notice Registers a student record with their 3 subject marks.
     * @param _studentId Unique student identifier.
     * @param _name Student full name.
     * @param _marks Array containing marks of exactly 3 subjects.
     */
    function register( 
        uint256 _studentId, 
        string memory _name, 
        uint256[] memory _marks 
    ) public onlyOwner returns (uint256) { 
        require(!students[_studentId].exist, "Student data already exists."); 
        require(_marks.length == 3, "Only 3 subjects are allowed. Array length must be 3."); 
        
        uint256 totalMarks = getArraySum(_marks); 
        uint256 percentage = totalMarks / 3; 
        
        students[_studentId] = Student({ 
            studentId: _studentId, 
            name: _name, 
            marks: _marks, 
            percentage: percentage, 
            exist: true 
        }); 
        
        emit StudentRegistered(_studentId, _name, percentage); 
        return percentage; 
    }

    /**
     * @notice Retrieves the stored student details.
     * @param _studentId The student ID to query.
     */
    function getStudentDetails(uint256 _studentId) 
        public 
        view 
        returns ( 
            uint256 studentId, 
            string memory name, 
            uint256[] memory marks, 
            uint256 percentage 
        )
    {
        require(students[_studentId].exist, "No student data available for this ID."); 
        Student memory s = students[_studentId]; 
        return (s.studentId, s.name, s.marks, s.percentage); 
    }

    /**
     * @notice Internal helper function to sum up an array of marks.
     */
    function getArraySum(uint256[] memory array) private pure returns (uint256 sum) { 
        sum = 0; 
        for (uint256 i = 0; i < array.length; i++) { 
            require(array[i] <= 100, "Marks must be between 0 and 100."); 
            sum += array[i]; 
        }
        return sum; 
    }

    // 3. Fallback function: Executed when a non-existent function is invoked or arbitrary data is sent
    fallback() external payable { 
        emit FallbackCalled(msg.sender, msg.value, msg.data); 
    }

    // Receive function: Handles direct Ether transfers with empty calldata
    receive() external payable { 
        emit FallbackCalled(msg.sender, msg.value, ""); 
    }
}
